# Copy to .env and fill in. Never commit .env.
DATABASE_URL=
DIRECT_URL=

# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ENCRYPTION_KEY=

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Must match the redirect URI registered in the Zoho API console
ZOHO_REDIRECT_URI=http://localhost:3000/api/auth/zoho/callback

# Optional: if set, /api/auth/zoho/start requires ?key=<SETUP_KEY>
SETUP_KEY=
